{
  "extends": "@react-native/typescript-config",
  "compilerOptions": {
    "types": [
      "jest"
    ],
    "strict": true,
    "baseUrl": "./",
    "paths": {
      "@components": [
        "./src/components"
      ],
      "@routes": [
        "./src/routes"
      ],
      "@screens": [
        "./src/screens"
      ],
      "@theme": [
        "./src/theme"
      ],
      "@hooks": [
        "./src/hooks"
      ],
      "@domain": [
        "./src/domain"
      ],
      "@services": [
        "./src/services"
      ],
      "@infra": [
        "./src/infra"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "nativewind-env.d.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/Pods"
  ]
}